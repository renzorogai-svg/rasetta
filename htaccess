<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header always set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0, no-transform"
        Header always set Pragma "no-cache"
        Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
        Header always set Surrogate-Control "no-store"
        Header always set X-Accel-Expires "0"
    </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
    CacheDisable public /
</IfModule>
